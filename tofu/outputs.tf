output "cloud_run_service_name" {
  description = "The name of the deployed Cloud Run service."
  value       = google_cloud_run_v2_service.mcp_service.name
}

output "cloud_run_service_uri" {
  description = "The direct *.run.app URL generated by Google Cloud Run."
  value       = google_cloud_run_v2_service.mcp_service.uri
}

output "custom_domain_url" {
  description = "The custom domain HTTPS endpoint for yft-sandbox-mcp."
  value       = "https://${var.domain_name}"
}

output "custom_domain_mcp_endpoint" {
  description = "The full MCP client URL to configure in AI tools. Requires the secret in secrets/mcp-auth-token (Bearer header or ?token=)."
  value       = "https://${var.domain_name}/mcp"
}

output "dns_records_to_configure" {
  description = "DNS records that must be created in your external DNS provider for nachochips.tsutsumi.io."
  value = try(
    [
      for record in google_cloud_run_domain_mapping.domain.status[0].resource_records : {
        type   = record.type
        name   = record.name != null && record.name != "" ? record.name : "@"
        rrdata = record.rrdata
      }
    ],
    [
      {
        type   = "CNAME"
        name   = "nachochips"
        rrdata = "ghs.googlehosted.com."
      }
    ]
  )
}

output "artifact_registry_repository_url" {
  description = "The URL of the Artifact Registry Docker repository."
  value       = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.docker_repo.repository_id}"
}

output "docker_build_and_push_commands" {
  description = "Commands to build and deploy the container image to Cloud Run."
  value       = <<EOT
# 1. Authenticate Docker with Google Artifact Registry
gcloud auth configure-docker ${var.region}-docker.pkg.dev

# 2. Build the Docker container image
docker build -t ${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.docker_repo.repository_id}/server:latest .

# 3. Push the container image to Artifact Registry
docker push ${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.docker_repo.repository_id}/server:latest

# 4. Trigger Cloud Run update with the newly pushed image
gcloud run deploy ${google_cloud_run_v2_service.mcp_service.name} \
  --image ${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.docker_repo.repository_id}/server:latest \
  --region ${var.region}
EOT
}
